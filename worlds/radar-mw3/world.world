// mp_radar — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Radar (MW3)"
  description: "Modern Warfare 3's mp_radar, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_radar.vision`.
grade {
  light-tint: 0.972 1.095 1.224
  medium-tint: 1.0 0.922 1.112
  dark-tint: 0.901 0.921 1.209
  desaturation: 0.0
  desaturation-dark: 0.0
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 896 180 926
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 966 181 997
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "ladder.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-43.0 18.0 0.0", sunlight "1.17", ambient "0.001", _color "0.866667 0.921569 1.0".
light sun { type: directional, at: 83.5 81.8 -27.1, intensity: 1.17, color: #ddebff, shadows: on }
light fill { type: ambient, intensity: 0.001, color: #ddebff }

spawn { at: -185.13 36.24 -117.58, look: -183.05 36.04 -107.8 }
