// mp_seatown — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Seatown (MW3)"
  description: "Modern Warfare 3's mp_seatown, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_seatown.vision`.
grade {
  light-tint: 1.60118 1.86035 1.83844
  medium-tint: 1.08674 1.11939 1.0
  dark-tint: 0.968935 0.787964 0.73642
  desaturation: 0.251026
  desaturation-dark: 0.25132
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 1032 86 1274
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 110 21 386
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "ladder.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-58.9 120.8 0.0", sunlight "1.1", ambient "0.116", _color "0.87 0.94 1.0".
light sun { type: directional, at: -31.7 102.8 -53.2, intensity: 1.1, color: #fffcf2, shadows: on }
light fill { type: ambient, intensity: 0.116, color: #def0ff }

spawn { at: -52.71 7.39 -34.69, look: -52.71 7.19 -24.69 }
