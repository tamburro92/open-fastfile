// mp_plaza2 — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Plaza2 (MW3)"
  description: "Modern Warfare 3's mp_plaza2, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_plaza2.vision`.
grade {
  light-tint: 1.53 1.41 1.09
  medium-tint: 0.852015 0.922552 1.00822
  dark-tint: 0.696122 0.91823 1.07292
  desaturation: 0.341144
  desaturation-dark: 0.25
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 606 56 707
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 650 72 650
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-32.0 72.0 0.0", sunlight "1.0", ambient "0.116", _color "0.541176 0.843137 1.0".
light sun { type: directional, at: 31.4 63.6 -96.8, intensity: 1.0, color: #ffddae, shadows: on }
light fill { type: ambient, intensity: 0.116, color: #8ad7ff }

spawn { at: -18.39 19.63 -48.72, look: -13.39 19.43 -40.06 }
