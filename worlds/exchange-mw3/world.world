// mp_exchange — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Exchange (MW3)"
  description: "Modern Warfare 3's mp_exchange, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_exchange.vision`.
grade {
  light-tint: 1.10838 1.10717 1.15409
  medium-tint: 0.90419 1.01765 1.07704
  dark-tint: 0.7 0.928125 1.0
  desaturation: 0.352396
  desaturation-dark: 0.352396
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 1764 442 1632
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 707 278 616
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-50.0 190.0 0.0", sunlight "1.3", ambient "0.16", _color "0.823529 0.909804 1.0".
light sun { type: directional, at: -76.0 91.9 13.4, intensity: 1.3, color: #fff5d0, shadows: on }
light fill { type: ambient, intensity: 0.16, color: #d2e8ff }

spawn { at: 68.15 4.59 -27.27, look: 58.3 4.39 -25.54 }
