// mp_lambeth — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Lambeth (MW3)"
  description: "Modern Warfare 3's mp_lambeth, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_lambeth.vision`.
grade {
  light-tint: 1.13515 1.1417 1.12529
  medium-tint: 0.475941 0.450092 0.364724
  dark-tint: 0.473174 0.494586 0.548584
  desaturation: 0.0792191
  desaturation-dark: 0.0329251
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 1943 57 1816
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 730 26 451
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-62.0 123.0 0.0", sunlight "1.47732", ambient "0.16", _color "0.427451 0.47451 0.552941".
light sun { type: directional, at: -30.7 106.0 -47.2, intensity: 1.477, color: #f4f7d1, shadows: on }
light fill { type: ambient, intensity: 0.16, color: #6d798d }

spawn { at: -27.12 -2.98 23.9, look: -20.69 -3.18 16.24 }
