// mp_interchange — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Interchange (MW3)"
  description: "Modern Warfare 3's mp_interchange, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_interchange.vision`.
grade {
  light-tint: 1.19145 1.22764 1.26224
  medium-tint: 0.929309 0.999472 1.0161
  dark-tint: 0.756323 0.978485 1.08842
  desaturation: 0.19771
  desaturation-dark: 0.149498
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 2278 76 2290
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 1216 81 1214
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "ladder.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-41.0 -13.0 0.0", sunlight "1.3", ambient "0.116", _color "0.658824 0.796078 1.0".
light sun { type: directional, at: 88.2 78.7 20.4, intensity: 1.3, color: #fff7df, shadows: on }
light fill { type: ambient, intensity: 0.116, color: #a8cbff }

spawn { at: 25.7 5.18 83.48, look: 25.33 4.98 73.48 }
