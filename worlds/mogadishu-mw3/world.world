// mp_mogadishu — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Mogadishu (MW3)"
  description: "Modern Warfare 3's mp_mogadishu, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_mogadishu.vision`.
grade {
  light-tint: 1.18268 1.14947 1.07553
  medium-tint: 0.986253 1.01084 1.01995
  dark-tint: 0.371494 0.684741 0.630814
  desaturation: 0.10659
  desaturation-dark: 0.0592962
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 1909 89 1614
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 742 26 489
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-45.0 -144.0 0.0", sunlight "1.0", ambient "0.1".
light sun { type: directional, at: -68.6 84.9 49.9, intensity: 1.0, color: #ffffe3, shadows: on }
light fill { type: ambient, intensity: 0.1, color: #cce6ff }

spawn { at: 38.61 1.6 35.36, look: 38.61 1.4 25.36 }
