// so_deltacamp — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Deltacamp (MW3)"
  description: "Modern Warfare 3's so_deltacamp, imported from the game's own fastfile."
  category: "MW3 Special Ops"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `so_deltacamp.vision`.
grade {
  light-tint: 1.47 1.61 1.95
  medium-tint: 1.18 1.29 1.52
  dark-tint: 0.55 0.94 1.22
  desaturation: 0.0
  desaturation-dark: 0.161
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 234 22 286
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 234 52 338
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"

// worldspawn: sundirection "-70.0 72.0 0.0", sunlight "0.74", ambient "0.116", _color "0.87 0.94 1.0".
light sun { type: directional, at: 12.7 112.8 -39.0, intensity: 0.74, color: #e0edff, shadows: on }
light fill { type: ambient, intensity: 0.116, color: #def0ff }

// No spawn entity found; placed above the shell's centre.
spawn { at: 0 2 0, look: 0 2 -10 }
