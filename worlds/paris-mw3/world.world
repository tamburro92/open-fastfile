// mp_paris — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Paris (MW3)"
  description: "Modern Warfare 3's mp_paris, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_paris.vision`.
grade {
  light-tint: 1.05739 1.04425 0.984401
  medium-tint: 0.999931 1.02679 1.04154
  dark-tint: 0.869662 0.955874 0.984114
  desaturation: 0.256089
  desaturation-dark: 0.0
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 1040 59 910
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 245 30 189
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-69.0 144.0 0.0", sunlight "1.5", ambient "0.116", _color "0.87 0.94 1.0".
light sun { type: directional, at: -34.8 112.0 -25.3, intensity: 1.5, color: #fffef0, shadows: on }
light fill { type: ambient, intensity: 0.116, color: #def0ff }

spawn { at: -49.44 8.53 -42.75, look: -42.37 8.33 -35.68 }
