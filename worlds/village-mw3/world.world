// mp_village — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Village (MW3)"
  description: "Modern Warfare 3's mp_village, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_village.vision`.
grade {
  light-tint: 1.82627 1.698 1.478
  medium-tint: 0.96761 1.05296 1.10036
  dark-tint: 0.443423 0.501862 0.641225
  desaturation: 0.155718
  desaturation-dark: 0.157118
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 734 57 763
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 692 67 764
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-70.0 72.0 0.0", sunlight "1.5", ambient "0.05", _color "0.921569 1.0 0.988235".
light sun { type: directional, at: 12.7 112.8 -39.0, intensity: 1.5, color: #ffe0b7, shadows: on }
light fill { type: ambient, intensity: 0.05, color: #ebfffc }

spawn { at: -39.01 11.55 41.45, look: -34.32 11.35 32.62 }
