// mp_carbon — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Carbon (MW3)"
  description: "Modern Warfare 3's mp_carbon, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_carbon.vision`.
grade {
  light-tint: 1.15112 1.13185 1.04157
  medium-tint: 1.04441 1.02358 0.977009
  dark-tint: 0.931106 1.05066 1.11198
  desaturation: 0.167543
  desaturation-dark: 0.0
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 1652 360 1327
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 250 69 352
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "ladder.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-30.0 -48.0 0.0", sunlight "1.3898", ambient "0.116", _color "0.87 0.94 1.0".
light sun { type: directional, at: 69.5 60.0 77.2, intensity: 1.39, color: #eaead1, shadows: on }
light fill { type: ambient, intensity: 0.116, color: #def0ff }

spawn { at: 18.14 102.1 95.3, look: 8.21 101.9 96.54 }
