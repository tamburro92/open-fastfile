// mp_underground — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Underground (MW3)"
  description: "Modern Warfare 3's mp_underground, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_underground.vision`.
grade {
  light-tint: 1.35686 1.38039 1.27059
  medium-tint: 1.08235 1.11373 1.09804
  dark-tint: 0.815686 0.847059 0.933333
  desaturation: 0.211113
  desaturation-dark: 0.210477
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 1206 215 1401
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 299 159 867
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-70.0 -156.111 0.0", sunlight "0.956", ambient "0.116", _color "0.729412 0.858824 1.0".
light sun { type: directional, at: -37.5 112.8 16.6, intensity: 0.956, color: #e5e9d1, shadows: on }
light fill { type: ambient, intensity: 0.116, color: #badbff }

spawn { at: 0.86 2.41 33.16, look: 0.86 2.21 23.16 }
