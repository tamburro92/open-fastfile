// mp_bravo — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Bravo (MW3)"
  description: "Modern Warfare 3's mp_bravo, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_bravo.vision`.
grade {
  light-tint: 1.99995 1.97158 1.51608
  medium-tint: 1.20236 1.16716 1.01679
  dark-tint: 0.63 0.91 0.82
  desaturation: 0.255128
  desaturation-dark: 0.209909
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 992 44 985
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 970 46 967
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-46.0 -30.0 0.0", sunlight "1.0", ambient "0.1", _color "0.658824 0.796078 1.0".
light sun { type: directional, at: 72.2 86.3 41.7, intensity: 1.0, color: #fffaed, shadows: on }
light fill { type: ambient, intensity: 0.1, color: #a8cbff }

spawn { at: 44.81 31.87 18.59, look: 44.81 31.67 8.59 }
