// mp_dome — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Dome (MW3)"
  description: "Modern Warfare 3's mp_dome, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_dome.vision`.
grade {
  light-tint: 1.59238 1.56238 1.40199
  medium-tint: 1.07764 1.0866 1.09892
  dark-tint: 0.706566 0.904928 1.05143
  desaturation: 0.191536
  desaturation-dark: 0.0538634
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 2781 68 2423
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 91 31 102
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "ladder.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-36.0 72.0 0.0", sunlight "1.2", ambient "0.156", _color "0.87 0.94 1.0".
light sun { type: directional, at: 30.0 70.5 -92.3, intensity: 1.2, color: #fffbec, shadows: on }
light fill { type: ambient, intensity: 0.156, color: #def0ff }

spawn { at: -6.49 -5.44 -41.41, look: -2.5 -5.64 -32.24 }
