// mp_hardhat — Modern Warfare 3, imported from the game's own fastfile.
// GENERATED by `python3 -m scripts.cod export`: hand edits belong in _overrides.json.
// Lighting, grading and spawn are the map's own values. See docs/cod/README.md.

world {
  name: "Hardhat (MW3)"
  description: "Modern Warfare 3's mp_hardhat, imported from the game's own fastfile."
  category: "MW3 Multiplayer"
  game: iw5
  sky: #b9c6d4
  visibility: 600
  exposure: 0.5
}


// The map's own colour grading (r_film* cvars), from its `mp_hardhat.vision`.
grade {
  light-tint: 1.83318 1.5472 1.13824
  medium-tint: 1.01376 1.00024 0.985463
  dark-tint: 0.916 0.744 0.69
  desaturation: 0.2806
  desaturation-dark: 0.258799
}

asset world { source: "assets/world.glb" }
asset decals { source: "assets/decals.glb" }

group map {
  at: 0 0 0

  // Collision comes from the map's clipmap (`collision` below), not this mesh.
  model shell {
    asset: world
    at: 0 0 0
    size: 1005 302 1020
    collide: false
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }

  // Rendered, never collided, depth-biased by `decal: on`. Lightmap values
  // match the shell's so each decal is lit like the wall under it.
  model decals {
    asset: decals
    at: 0 0 0
    size: 640 184 316
    collide: false
    decal: on
    lightmap: "assets/lightmap.png"
    lightmap-intensity: 0.1
  }
}

collision { source: "assets/collision.glb" }

include "props.world"
include "gameplay.world"
include "minimap.world"
include "mantle.world"
include "navigation.world"
include "fx.world"
include "sound.world"

// worldspawn: sundirection "-65.0 72.0 0.0", sunlight "1.2", ambient "0.116", _color "0.87 0.94 1.0".
light sun { type: directional, at: 15.7 108.8 -48.2, intensity: 1.2, color: #e0edff, shadows: on }
light fill { type: ambient, intensity: 0.116, color: #def0ff }

spawn { at: -3.45 11.66 -30.68, look: 1.55 11.46 -22.02 }
